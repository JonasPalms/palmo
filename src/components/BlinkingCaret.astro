---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<span class:list={["caret", className]} aria-hidden="true">_</span>

<style>
  .caret {
    color: var(--color-accent);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
