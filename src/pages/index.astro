---
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"
import Nav from "../components/Nav.astro"
import BlinkingCaret from "../components/BlinkingCaret.astro"
import ProjectCard from "../components/ProjectCard.astro"

const projects = await getCollection("projects")
const featuredProjects = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<Base title="Jonas Palm — Frontend Developer">
  <div class="container">
    <Nav />

    <main>
      <!-- Hero / About Section -->
      <section class="hero">
        <h1 class="hero-title">
          jonas palm<BlinkingCaret />
        </h1>
        <p class="hero-subtitle">Frontend Developer</p>
        <p class="hero-bio">
          I build things for the web. Focused on creating polished, performant user interfaces and
          enjoyable developer experiences.
        </p>
        <div class="hero-links">
          <a href="https://github.com/username" target="_blank" rel="noopener"> GitHub </a>
          <a href="https://linkedin.com/in/username" target="_blank" rel="noopener"> LinkedIn </a>
          <a href="/contact">Contact</a>
        </div>
      </section>

      <!-- Work Section -->
      <section class="work">
        <h2 class="section-title">Work</h2>
        <div class="work-item">
          <div class="work-header">
            <h3 class="work-company">Apply Agency</h3>
            <span class="work-period">2022 — Present</span>
          </div>
          <p class="work-role">Frontend Developer</p>
          <p class="work-description">
            Building modern web experiences for clients across various industries.
          </p>
        </div>
      </section>

      <!-- Projects Section -->
      <section class="projects">
        <h2 class="section-title">Projects</h2>
        {
          featuredProjects.length > 0 ? (
            <div class="project-grid">
              {featuredProjects.map((project) => (
                <ProjectCard
                  title={project.data.title}
                  description={project.data.description}
                  slug={project.id}
                  tech={project.data.tech}
                />
              ))}
            </div>
          ) : (
            <p class="no-projects">Projects coming soon...</p>
          )
        }
      </section>
    </main>

    <footer class="footer">
      <p>&copy; {new Date().getFullYear()} Jonas Palm</p>
    </footer>
  </div>
</Base>

<style>
  main {
    min-height: calc(100vh - 200px);
  }

  /* Hero Section */
  .hero {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .hero-title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .hero-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .hero-bio {
    max-width: 40rem;
    color: var(--color-text);
    margin-bottom: var(--space-lg);
  }

  .hero-links {
    display: flex;
    gap: var(--space-lg);
  }

  .hero-links a {
    font-size: var(--font-size-sm);
  }

  /* Work Section */
  .work {
    padding-bottom: var(--space-2xl);
  }

  .work-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-lg);
  }

  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .work-company {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
  }

  .work-period {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .work-role {
    font-size: var(--font-size-base);
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .work-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  /* Projects Section */
  .projects {
    padding-bottom: var(--space-2xl);
  }

  .section-title {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .no-projects {
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Footer */
  .footer {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
