---
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"
import TypewriterText from "../components/TypewriterText.astro"
import ProjectCard from "../components/ProjectCard.astro"

const projects = await getCollection("projects")
const featuredProjects = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<Base title="Jonas Palm | Web Developer">
  <!-- Hero / About Section -->
  <section class="hero">
    <div class="hero-content">
      <div>
        <h1 class="hero-title">
          <TypewriterText
            segments={[{ type: "jonad pa", pause: 500, delete: 4 }, { type: "s palm" }]}
            caret
          />
        </h1>
        <p class="hero-subtitle">Web Developer</p>
        <p class="hero-bio">
          Hi, I’m Jonas — a web developer based in Copenhagen. I’m currently working at Apply
          Agency, helping clients build whatever their hearts desire. I enjoy working with new
          technologies and I’m always looking to expand my horizons.
        </p>
        <div class="hero-links">
          <a href="https://github.com/jonaspalms" target="_blank" rel="noopener"> GitHub </a>
          <a href="https://www.linkedin.com/in/jonaspalmsorensen/" target="_blank" rel="noopener">
            LinkedIn
          </a>
          <a href="/contact">Contact</a>
        </div>
      </div>
    </div>
  </section>

  <section class="work">
    <h2 class="section-title">Work</h2>
    <div class="work-item">
      <div class="work-header">
        <h3 class="work-company">Apply Agency</h3>
        <span class="work-period">2022 — Present</span>
      </div>
      <p class="work-role">Frontend Developer</p>
      <p class="work-description">
        At Apply, I work across a mix of product sites and web apps, ranging from content-heavy
        static sites to highly interactive, app-like experiences.
      </p>
    </div>
  </section>

  <!-- Projects Section -->
  <section class="projects">
    <h2 class="section-title">Projects</h2>
    {
      featuredProjects.length > 0 ? (
        <div class="project-grid">
          {featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              slug={project.id}
              tech={project.data.tech}
            />
          ))}
        </div>
      ) : (
        <p class="no-projects">Projects coming soon...</p>
      )
    }
  </section>
</Base>

<style>
  .hero {
    margin-top: var(--space-xl);
  }
  .hero-title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .hero-content {
    display: grid;
    align-items: center;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-sm);
  }
  .hero-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .hero-bio {
    max-width: 40rem;
    color: var(--color-text);
    margin-bottom: var(--space-lg);
  }

  .hero-links {
    display: flex;
    gap: var(--space-lg);
  }

  .hero-links a {
    font-size: var(--font-size-sm);
  }

  @media (max-width: 720px) {
    .hero-content {
      margin-bottom: var(--space-sm);
    }
  }

  /* Work Section */
  .work {
    margin-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  .work-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-lg);
  }

  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .work-company {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
  }

  .work-period {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .work-role {
    font-size: var(--font-size-base);
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .work-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  /* Projects Section */
  .projects {
    padding-bottom: var(--space-2xl);
  }

  .section-title {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .no-projects {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
