---
import Base from "../layouts/Base.astro"
---

<Base title="Contact — Jonas Palm" description="Get in touch with Jonas Palm">
  <section class="contact">
    <h1 class="contact-title">Contact</h1>
    <p class="contact-intro">
      Want to work together, have a question, or just want to say hi? Feel free to reach out through
      any of the channels below.
    </p>

    <div class="contact-methods">
      <a href="mailto:jonas.p.sorensen@gmail.com" class="contact-card">
        <span class="contact-label">Email</span>
        <span class="contact-value">jonas.p.sorensen@gmail.com</span>
      </a>

      <a href="https://github.com/JonasPalms" target="_blank" rel="noopener" class="contact-card">
        <span class="contact-label">GitHub</span>
        <span class="contact-value">@jonaspalmsorensen</span>
      </a>

      <a
        href="https://www.linkedin.com/in/jonaspalmsorensen/"
        target="_blank"
        rel="noopener"
        class="contact-card"
      >
        <span class="contact-label">LinkedIn</span>
        <span class="contact-value">/in/jonaspalmsorensen</span>
      </a>
    </div>
    <p class="contact-fun">
      Ask me about: building smooth UIs, weird edge cases, or my current favorite beer.
    </p>
  </section>
</Base>

<style>
  .contact {
    padding: var(--space-xl) 0 var(--space-2xl);
    max-width: 40rem;
  }

  .contact-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .contact-intro {
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    font-size: var(--font-size-lg);
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .contact-card:hover {
    border-color: var(--color-accent);
    transform: translateX(4px);
    text-decoration: none;
  }

  .contact-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-value {
    font-size: var(--font-size-lg);
    color: var(--color-accent);
    font-weight: 500;
  }

  .contact-fun {
    color: var(--color-text);
    font-size: var(--font-size-base);
    margin-bottom: var(--space-md);
  }
</style>
